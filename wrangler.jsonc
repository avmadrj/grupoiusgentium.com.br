{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ius-gentium",
  "main": "worker/index.tsx",
  "compatibility_date": "2026-08-08",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "routes": [
    {
      "pattern": "grupoiusgentium.com.br/*",
      "zone_name": "grupoiusgentium.com.br"
    },
    {
      "pattern": "www.grupoiusgentium.com.br/*",
      "zone_name": "grupoiusgentium.com.br"
    }
  ],
  "observability": {
    "enabled": true
  }
}
